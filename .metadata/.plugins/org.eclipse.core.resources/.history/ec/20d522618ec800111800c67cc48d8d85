package ejercicio06;

import java.util.List;

public class AlumnosService {
//Un servicio entrega datos tras ser procesados
	private AlumnosRepository alumnosRepository;

	public AlumnosService() {
		super();
		alumnosRepository=new AlumnosRepository();
	}
	
	public List<AlumnoResponse> getNombreAlumnosAprobadosYMateriasSuspensas() {
		return alumnosRepository.findAlumnosAprobados().stream()
				.map(alumno->
				new Alumno2AlumnoResponseMapper().convert(alumno))
				.toList();
	}
	
}
